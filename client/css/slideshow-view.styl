@import colors

// the slideshow covers the whole window, top navigation included
body.slideshow-active
    overflow: hidden

.slideshow
    position: fixed
    inset: 0
    z-index: 1000
    background: black
    color: white
    cursor: pointer

    .slideshow-stage
        width: 100%
        height: 100%
        img, video
            display: block
            width: 100%
            height: 100%
            object-fit: contain

    .slideshow-message
        position: absolute
        top: 50%
        left: 0
        right: 0
        margin: 0
        transform: translateY(-50%)
        text-align: center
        &:empty
            display: none

    // hidden until the slideshow is clicked
    .slideshow-controls
        position: absolute
        bottom: 2em
        left: 50%
        transform: translateX(-50%)
        display: flex
        gap: 0.3em
        padding: 0.3em
        border-radius: $ui-border-radius
        background: rgba(0, 0, 0, 0.65)
        box-shadow: 0 0 1em rgba(0, 0, 0, 0.5)
        cursor: default
        opacity: 0
        pointer-events: none
        transition: opacity 0.2s linear
        &.shown
            opacity: 1
            pointer-events: auto

        button
            width: 2.6em
            height: 2.6em
            padding: 0
            border: 0
            border-radius: $ui-border-radius
            background: none
            color: white
            font-size: 120%
            transition: box-shadow 0.2s linear, color 0.2s linear
            // same accent outline + glow as the dark theme buttons
            &:hover, &:focus-visible
                box-shadow: inset 0 0 0 0.15em $main-color, inset 0 0 0.8em $main-color-glow
            &.active
                color: $main-color
