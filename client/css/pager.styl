@import colors
@import mixins

.pager
    nav
        .disabled
            opacity: .5
        a.prev:not(.disabled), a.next:not(.disabled)
            accent-text-glow()

    .page
        position: relative
        .page-header
            margin: 0.5em 0
            position: relative
            &:before
                display: block
                content: ''
                position: absolute
                left: 0
                top: 50%
                right: 0
                height: 3px
                background: $top-navigation-color
                z-index: 1
            span
                position: relative
                background: $window-color
                padding: 0 1em
                z-index: 2

.darktheme .pager
    .page
        .page-header
            &:before
                background: $top-navigation-color-darktheme
            span
                background: $window-color-darktheme
