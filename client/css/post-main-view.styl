@import colors

// Post on top, then buttons + details in one row, then relations/tags
// on the left with comments on the right. In edit mode the buttons and the
// edit form sit in a column left of the post instead. The wrappers are
// display: contents so their children land directly in the grid.
.post-view
    width: 100%
    display: grid !important
    grid-template-columns: 21em minmax(0, 1fr)
    grid-template-areas: "post post" "buttons details" "side comments"
    align-items: start
    column-gap: 2em

    >.sidebar, >.sidebar>.sidebar-container, .readonly-sidebar
        display: contents

    >.sidebar
        line-height: 160%

        a:active
            border: 0
            outline: 0

    .post-container
        grid-area: post
        margin-bottom: 0.6em

        .post-content
            margin: 0

    // stretched to the row's height, so the details beside it and the
    // icons inside it share one vertical center
    nav.buttons
        grid-area: buttons
        align-self: stretch
        margin: 0
        display: flex
        flex-wrap: wrap
        gap: 0.2em
        article
            flex: 1 0 30%
            display: flex
            border-radius: $ui-border-radius
            background: $active-tab-background-color
            a
                display: flex
                align-items: center
                justify-content: center
                width: 100%
                padding: 0.3em 0
                border-radius: $ui-border-radius
                transition: background 0.2s linear, box-shadow 0.2s linear
                &:not(.inactive):hover
                    background: $main-color-hover-background
            i
                font-size: 140%
            text-align: center

    .readonly-sidebar>.details
        grid-area: details
        align-self: center

    .readonly-sidebar>.taxonomy, .edit-sidebar
        grid-area: side
        min-width: 0

    >.post-comments
        grid-area: comments
        min-width: 0
        margin-top: 1em

.post-view.edit-mode
    grid-template-rows: auto auto 1fr
    grid-template-areas: "buttons post" "side post" "side comments"

    >.post-comments
        margin-top: 0

    nav.buttons
        align-self: start
        margin-bottom: 1em

.darktheme .post-view
    .readonly-sidebar .details section
        background: $focused-tab-background-color-darktheme
    nav.buttons
        article
            background: $active-tab-background-color-darktheme
            a:not(.inactive):hover
                background: unset
                box-shadow: inset 0 0 0 0.15em $main-color, inset 0 0 0.8em $main-color-glow

@media (max-width: 800px)
    .post-view, .post-view.edit-mode
        grid-template-columns: minmax(0, 1fr)
        grid-template-rows: none
        grid-template-areas: "post" "buttons" "details" "side" "comments"

        nav.buttons
            margin-bottom: 0.6em


.post-view .readonly-sidebar
    .details
        display: flex
        flex-wrap: wrap
        align-items: center
        gap: 0.5em

        section
            padding: 0.3em 0.8em
            border-radius: $ui-border-radius
            background: $focused-tab-background-color

        i
            margin-right: 0.6em
            display: inline-block
            width: 1em
            text-align: center

        .safety-safe
            color: $safety-safe
        .safety-sketchy
            color: $safety-sketchy
        .safety-unsafe
            color: $safety-unsafe

        .upload-info
            .thumbnail
                width: 1em
                height: 1em
                margin: -0.1em 0.6em 0 0

        .zoom
            a
                display: inline-block
            .active
                text-decoration: underline

        .social
            display: flex
            gap: 2em
            .score-container
                .downvote i
                    text-align: right
            i
                text-align: left
                margin: 0
            .value
                text-align: center
                display: inline-block
                width: 2em

    .relations
        margin-top: 1em
        h1
            margin-bottom: 0.5em
        .thumbnail
            width: 4em
            height: 3em
            background-position: 50% 30%
        li
            margin: 0 0.3em 0.3em 0
            display: inline-block

    .tags
        margin-top: 1em
    .relations + .tags
        margin-top: 2em
        h1
            margin-bottom: 0.5em

.post-view .edit-sidebar
    .expander-content
        section:not(:last-child)
            margin-bottom: 1em

    .safety
        &>label
            width: 100%
        .radio-wrapper
            display: flex
            flex-wrap: wrap
        .radio-wrapper label
            flex-grow: 1
            display: inline-block

    .management
        ul
            list-style-type: none
            margin: 0
            padding: 0
            li
                margin: 0
                padding: 0

    .post-source
        textarea
            white-space: pre
            overflow-wrap: normal
            overflow-x: scroll

    form
        width: auto

    label:not(.file-dropper)
        margin-bottom: 0.3em
        display: block

    input[type=submit],
    input[type=button],
    button
        width: 100%
        &:focus
            border: 2px solid $text-color !important

    .messages
        margin-top: 1em
