@import colors
@import mixins

// Post on top, then buttons + details in one row, then relations/tags
// on the left with comments on the right. In edit mode the buttons and the
// edit form sit in a column left of the post instead. The wrappers are
// display: contents so their children land directly in the grid.
.post-view
    width: 100%
    display: grid !important
    grid-template-columns: 21em minmax(0, 1fr)
    grid-template-areas: "post post" "buttons details" "side comments"
    align-items: start
    column-gap: 2em

    >.sidebar, >.sidebar>.sidebar-container, .readonly-sidebar
        display: contents

    >.sidebar
        line-height: 160%

        a:active
            border: 0
            outline: 0

    .post-container
        grid-area: post
        margin-bottom: 0.6em

        .post-content
            margin: 0

    // stretched to the row's height, so the details beside it and the
    // icons inside it share one vertical center
    nav.buttons
        grid-area: buttons
        align-self: stretch
        margin: 0
        display: flex
        flex-wrap: wrap
        gap: 0.2em
        article
            flex: 1 0 30%
            display: flex
            border-radius: $ui-border-radius
            background: $active-tab-background-color
            a
                display: flex
                align-items: center
                justify-content: center
                width: 100%
                padding: 0.3em 0
                border-radius: $ui-border-radius
                transition: background 0.2s linear, box-shadow 0.2s linear
                &:not(.inactive):hover
                    background: $main-color-hover-background
            i
                font-size: 140%
            text-align: center

    .readonly-sidebar>.details
        grid-area: details
        align-self: center

    .readonly-sidebar>.taxonomy, .edit-sidebar
        grid-area: side
        min-width: 0

    // the comments and the post info (.info) start on the same line, far
    // enough below the buttons to stay out of view when the post fills
    // the viewport (more than the 1.5em page gutter)
    >.post-comments
        grid-area: comments
        min-width: 0
        margin-top: 2em
        >h2:first-child
            margin-top: 0
        .add-comment-toggle
            margin-bottom: 1em
            i
                margin-right: 0.5em
        &:not(.adding-comment) .comment-form-container
            display: none

.post-view.edit-mode
    grid-template-rows: auto auto 1fr
    grid-template-areas: "buttons post" "side post" "side comments"

    >.post-comments
        margin-top: 0

    nav.buttons
        align-self: start
        margin-bottom: 1em

.darktheme .post-view
    .readonly-sidebar .details section, .readonly-sidebar .info section
        background: $focused-tab-background-color-darktheme
    .readonly-sidebar .details .zoom
        .zoom-options
            background: $top-navigation-color-darktheme
            box-shadow: 0 -0.2em 0.6em rgba(0, 0, 0, 0.5)
            a
                color: $inactive-link-color-darktheme
                &:not(.active):hover
                    background: unset
                    box-shadow: inset 0 0 0 0.15em $main-color, inset 0 0 0.8em $main-color-glow
                    color: $text-color-darktheme
                &.active
                    background: $active-tab-background-color-darktheme
                    color: $text-color-darktheme
    nav.buttons
        article
            background: $active-tab-background-color-darktheme
            a:not(.inactive):hover
                background: unset
                box-shadow: inset 0 0 0 0.15em $main-color, inset 0 0 0.8em $main-color-glow

@media (max-width: 800px)
    .post-view, .post-view.edit-mode
        grid-template-columns: minmax(0, 1fr)
        grid-template-rows: none
        grid-template-areas: "post" "buttons" "details" "side" "comments"

        nav.buttons
            margin-bottom: 0.6em


.post-view .readonly-sidebar
    // shared by the row beside the buttons (zoom, score) and the post info
    // above relations/tags
    .details, .info
        gap: 0.3em

        section
            padding: 0.2em 0.5em
            border-radius: $ui-border-radius
            background: $focused-tab-background-color

        i
            margin-right: 0.6em
            display: inline-block
            width: 1em
            text-align: center

    .info
        display: flex
        flex-direction: column
        margin-top: 2em

        .safety-safe
            color: $safety-safe
        .safety-sketchy
            color: $safety-sketchy
        .safety-unsafe
            color: $safety-unsafe

        .upload-info
            .thumbnail
                width: 1em
                height: 1em
                margin: -0.1em 0.6em 0 0

    .details
        display: flex
        flex-wrap: wrap
        align-items: center

        // icon button opening a list of fit modes
        .zoom
            position: relative
            padding: 0
            // match the height of the text tiles beside it
            align-self: stretch
            display: flex
            .zoom-toggle
                padding: 0.2em 0.5em
                border: 0
                border-radius: $ui-border-radius
                background: none
                color: $main-color
                font-size: 110%
                accent-button-hover()
                i
                    margin: 0
            // opens upwards: the details row sits at the bottom of the
            // viewport in the fit-both/fit-height modes
            .zoom-options
                display: none
                position: absolute
                bottom: calc(100% + 0.3em)
                left: 0
                z-index: 20
                margin: 0
                padding: 0.2em
                list-style-type: none
                white-space: nowrap
                border-radius: $ui-border-radius
                background: $top-navigation-color
                box-shadow: 0 -0.2em 0.6em rgba(0, 0, 0, 0.15)
                li
                    margin: 0
                // same look as the top navigation dropdown entries
                a
                    display: block
                    padding: 0 1em
                    line-height: 2.3em
                    border-radius: $ui-border-radius
                    color: $inactive-link-color
                    transition: background 0.2s linear, box-shadow 0.2s linear
                    &:not(.active):hover
                        background: $main-color-hover-background
                        color: $text-color
                    &.active
                        background: $active-tab-background-color
                        color: $text-color
            &.opened .zoom-options
                display: block

        // the score and favorite controls are small buttons filling the tile
        .social
            display: flex
            align-self: stretch
            gap: 1em
            padding: 0
            .score-container, .fav-container
                display: flex
                align-items: stretch
            a
                display: flex
                align-items: center
                padding: 0 0.5em
                border-radius: $ui-border-radius
                accent-button-hover()
            i
                margin: 0
            .value
                display: flex
                align-items: center
                justify-content: center
                min-width: 1.5em

    // same size as the "Comments" header
    .relations h1, .tags h1
        font-size: 1.5em

    .relations
        margin-top: 1em
        h1
            margin-bottom: 0.5em
        .thumbnail
            width: 4em
            height: 3em
            background-position: 50% 30%
        li
            margin: 0 0.3em 0.3em 0
            display: inline-block

    .tags
        margin-top: 1em
    .relations + .tags
        margin-top: 2em
        h1
            margin-bottom: 0.5em

.post-view .edit-sidebar
    .expander-content
        section:not(:last-child)
            margin-bottom: 1em

    .safety
        &>label
            width: 100%
        .radio-wrapper
            display: flex
            flex-wrap: wrap
        .radio-wrapper label
            flex-grow: 1
            display: inline-block

    .management
        ul
            list-style-type: none
            margin: 0
            padding: 0
            li
                margin: 0
                padding: 0

    .post-source
        textarea
            white-space: pre
            overflow-wrap: normal
            overflow-x: scroll

    form
        width: auto

    label:not(.file-dropper)
        margin-bottom: 0.3em
        display: block

    input[type=submit],
    input[type=button],
    button
        width: 100%
        &:focus
            border: 2px solid $text-color !important

    .messages
        margin-top: 1em
