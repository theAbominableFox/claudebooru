<div class='slideshow'>
    <div class='slideshow-stage'></div>
    <p class='slideshow-message'></p>
    <nav class='slideshow-controls'>
        <button type='button' class='previous' title='Previous (Left)' aria-label='Previous'><i class='fa fa-chevron-left'></i></button>
        <button type='button' class='pause' title='Pause (Space)' aria-label='Pause'><i class='fa fa-pause'></i></button>
        <button type='button' class='next' title='Next (Right)' aria-label='Next'><i class='fa fa-chevron-right'></i></button>
        <button type='button' class='random' title='Random order (R)' aria-label='Random order' aria-pressed='false'><i class='fa fa-random'></i></button>
        <button type='button' class='exit' title='Exit (Esc)' aria-label='Exit'><i class='fa fa-times'></i></button>
    </nav>
</div>
